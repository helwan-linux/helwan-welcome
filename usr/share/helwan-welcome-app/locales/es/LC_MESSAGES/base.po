msgid "Welcome to Helwan Linux"
msgstr "Bienvenido a Helwan Linux"

msgid "Welcome to the world of Helwan Linux! ❤️\nWe are here to help you build your dreams on the strongest foundation!"
msgstr "¡Bienvenido al mundo de Helwan Linux! ❤️\nEstamos aquí para ayudarte a construir tus sueños sobre la base más sólida."

msgid "Show on startup"
msgstr "Mostrar al iniciar"

msgid "Application Language:"
msgstr "Idioma de la aplicación:"

msgid "System Language:"
msgstr "Idioma del sistema:"

msgid "Update System (Pacman)"
msgstr "Actualizar sistema (pacman)"

msgid "Update System (Yay)"
msgstr "Actualizar sistema (yay)"

msgid "Open Documentation"
msgstr "Abrir documentación"

msgid "Open YouTube Channel"
msgstr "Abrir canal de YouTube"

msgid "Show System Info"
msgstr "Mostrar información del sistema"

msgid "Performance Monitor"
msgstr "Monitor de rendimiento"

msgid "Language Changed"
msgstr "Idioma cambiado"

msgid "Language has been changed successfully."
msgstr "El idioma se ha cambiado correctamente."

msgid "Error"
msgstr "Error"

msgid "Could not update startup file:"
msgstr "No se pudo actualizar el archivo de inicio:"

msgid "Failed to apply system language:"
msgstr "No se pudo aplicar el idioma del sistema:"

msgid "System language applied successfully. You might need to restart your system for the changes to take full effect."
msgstr "El idioma del sistema se aplicó correctamente. Es posible que necesite reiniciar su sistema para que los cambios surtan efecto."

