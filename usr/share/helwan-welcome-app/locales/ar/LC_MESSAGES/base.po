msgid "Welcome to Helwan Linux"
msgstr "مرحبًا بك في هلوين لينكس"

msgid "Welcome to the world of Helwan Linux! ❤️\nWe are here to help you build your dreams on the strongest foundation!"
msgstr "مرحبًا بك في عالم حلوان لينكس! ❤️\nنحن هنا لمساعدتك على بناء أحلامك على أقوى الأسس!"

msgid "Show on startup"
msgstr "عرض عند بدء التشغيل"

msgid "Application Language:"
msgstr "لغة التطبيق:"

msgid "System Language:"
msgstr "لغة النظام:"

msgid "Update System (Pacman)"
msgstr "تحديث النظام (pacman)"

msgid "Update System (Yay)"
msgstr "تحديث النظام (yay)"

msgid "Open Documentation"
msgstr "فتح الوثائق"

msgid "Open YouTube Channel"
msgstr "فتح قناة يوتيوب"

msgid "Show System Info"
msgstr "عرض معلومات النظام"

msgid "Performance Monitor"
msgstr "مراقب الأداء"

msgid "Language Changed"
msgstr "تم تغيير اللغة"

msgid "Language has been changed successfully."
msgstr "تم تغيير اللغة بنجاح."

msgid "Error"
msgstr "خطأ"

msgid "Could not update startup file:"
msgstr "تعذر تحديث ملف بدء التشغيل:"

msgid "Failed to apply system language:"
msgstr "فشل في تطبيق لغة النظام:"

msgid "System language applied successfully. You might need to restart your system for the changes to take full effect."
msgstr "تم تطبيق لغة النظام بنجاح. قد تحتاج إلى إعادة تشغيل النظام لكي تكون التغييرات سارية بالكامل."


