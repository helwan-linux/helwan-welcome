msgid "Welcome to Helwan Linux"
msgstr "Bem-vindo ao Helwan Linux"

msgid "Welcome to the world of Helwan Linux! ❤️\nWe are here to help you build your dreams on the strongest foundation!"
msgstr "Bem-vindo ao mundo do Helwan Linux! ❤️\nEstamos aqui para ajudá-lo a construir seus sonhos na base mais sólida."

msgid "Show on startup"
msgstr "Mostrar ao iniciar"

msgid "Application Language:"
msgstr "Idioma do aplicativo:"

msgid "System Language:"
msgstr "Idioma do sistema:"

msgid "Update System (Pacman)"
msgstr "Atualizar sistema (pacman)"

msgid "Update System (Yay)"
msgstr "Atualizar sistema (yay)"

msgid "Open Documentation"
msgstr "Abrir documentação"

msgid "Open YouTube Channel"
msgstr "Abrir canal do YouTube"

msgid "Show System Info"
msgstr "Mostrar informações do sistema"

msgid "Performance Monitor"
msgstr "Monitor de desempenho"

msgid "Language Changed"
msgstr "Idioma alterado"

msgid "Language has been changed successfully."
msgstr "O idioma foi alterado com sucesso."

msgid "Error"
msgstr "Erro"

msgid "Could not update startup file:"
msgstr "Não foi possível atualizar o arquivo de inicialização:"

msgid "Failed to apply system language:"
msgstr "Falha ao aplicar o idioma do sistema:"

msgid "System language applied successfully. You might need to restart your system for the changes to take full effect."
msgstr "O idioma do sistema foi aplicado com sucesso. Pode ser necessário reiniciar o sistema para que as alterações tenham efeito."

